# jit-lab reads no per-app settings file. Port and bind come from the shell.
PORT=7570            # allowed range 7570-7579
# JITL_BIND=0.0.0.0  # opt-in only; Docker sets this itself
#
# Real mode (rule 19) is configured from the ONE shared settings file ~/Development/.env, not here:
#   JIT_LAB_PF_CLIENT_SECRET=...   # the shared local PingFederate client (rule 20: probed, reused,
#                                  # never spawned; client jit-lab-agent, recipe in ping-shared README)
#   # optional: JIT_LAB_PF_ENGINE=https://local.ping-devops.com:9031
#   # optional: JIT_LAB_PF_SCOPE=agent:invoke:identity
#   # or, instead of PF, your own PingOne tenant:
#   PINGONE_ENVIRONMENT_ID=... PINGONE_WORKER_CLIENT_ID=... PINGONE_WORKER_CLIENT_SECRET=...
# With neither set the Real button is disabled with a how-to tooltip and Mock answers everything.

# Host names (besides loopback) the lab answers to, e.g. local.ping-devops.com (must point at this Mac).
#LAB_ALLOWED_HOSTS=local.ping-devops.com
